@model List<VeterinerKlinigi.Models.Clinic>

@{
    ViewData["Title"] = "Klinikler";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Klinikler</h1>
        <a asp-action="CreateClinic" class="btn btn-success">+ Yeni Klinik</a>
    </div>

    @if (Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Ad</th>
                        <th>Adres</th>
                        <th>Telefon</th>
                        <th>Çalışma Saatleri</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clinic in Model)
                    {
                        <tr>
                            <td>@clinic.Name</td>
                            <td>@clinic.Address</td>
                            <td>@clinic.Phone</td>
                            <td>@clinic.OpeningTime.ToString(@"hh\:mm") - @clinic.ClosingTime.ToString(@"hh\:mm")</td>
                            <td>
                                <a asp-action="EditClinic" asp-route-id="@clinic.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                <a asp-action="DeleteClinic" asp-route-id="@clinic.Id" class="btn btn-sm btn-danger">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">Henüz klinik eklenmemiş.</div>
    }
</div>
