@model VeterinerKlinigi.Models.Veterinarian

@{
    ViewData["Title"] = "Yeni Veteriner Hekim Ekle";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-6">
            <h1>Yeni Veteriner Hekim Ekle</h1>

            <form asp-action="CreateVeterinarian" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label">Ad</label>
                        <input asp-for="FirstName" class="form-control" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label">Soyad</label>
                        <input asp-for="LastName" class="form-control" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="LicenseNumber" class="form-label">Lisans Numarası</label>
                    <input asp-for="LicenseNumber" class="form-control" required />
                    <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Specializations" class="form-label">Uzmanlık Alanları</label>
                    <input asp-for="Specializations" class="form-control" placeholder="Küçük Hayvan, Cerrahi" required />
                    <span asp-validation-for="Specializations" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClinicId" class="form-label">Klinik</label>
                    <select asp-for="ClinicId" class="form-select" required>
                        <option value="">Klinik Seç</option>
                        @foreach (var clinic in (List<VeterinerKlinigi.Models.Clinic>)ViewBag.Clinics)
                        {
                            <option value="@clinic.Id">@clinic.Name</option>
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime" class="form-label">Başlangıç Saati</label>
                        <input asp-for="StartTime" type="time" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndTime" class="form-label">Bitiş Saati</label>
                        <input asp-for="EndTime" type="time" class="form-control" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-success">Ekle</button>
                <a asp-action="Veterinarians" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
