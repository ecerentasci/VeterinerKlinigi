@model List<VeterinerKlinigi.Models.Veterinarian>

@{
    ViewData["Title"] = "Veteriner Hekimler";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Veteriner Hekimler</h1>
        <a asp-action="CreateVeterinarian" class="btn btn-success">+ Yeni Hekim</a>
    </div>

    @if (Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Lisans No</th>
                        <th>Uzmanlık</th>
                        <th>Klinik</th>
                        <th>Çalışma Saatleri</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vet in Model)
                    {
                        <tr>
                            <td>@vet.FirstName @vet.LastName</td>
                            <td>@vet.LicenseNumber</td>
                            <td>@vet.Specializations</td>
                            <td>@vet.Clinic.Name</td>
                            <td>@vet.StartTime.ToString(@"hh\:mm") - @vet.EndTime.ToString(@"hh\:mm")</td>
                            <td>
                                <a asp-action="EditVeterinarian" asp-route-id="@vet.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                <a asp-action="DeleteVeterinarian" asp-route-id="@vet.Id" class="btn btn-sm btn-danger">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">Henüz veteriner hekim eklenmemiş.</div>
    }
</div>
