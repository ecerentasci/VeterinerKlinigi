@model VeterinerKlinigi.Models.Service

@{
    ViewData["Title"] = "Hizmet Sil";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-6">
            <h3 class="text-danger">Hizmeti Silmek İstediğinize Emin Misiniz?</h3>

            <div class="alert alert-warning">
                <p><strong>Hizmet Adı:</strong> @Model.Name</p>
                <p><strong>Klinik:</strong> @Model.Clinic.Name</p>
                <p><strong>Fiyat:</strong> @Model.Price.ToString("C2")</p>
            </div>

            <form asp-action="DeleteService" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Sil</button>
                <a asp-action="Services" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>
